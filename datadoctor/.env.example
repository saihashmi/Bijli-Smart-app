# DataDoctor AI configuration. Copy to .env and adjust. Never commit .env.

# --- Storage & database ---
STORAGE_DIR=./storage            # uploaded originals, snapshots, exports, SQLite file
# DATABASE_URL=sqlite:///./storage/datadoctor.db   # optional override

# --- Limits (SPEC D4) ---
MAX_UPLOAD_MB=20
RETENTION_DAYS=7
PROCESS_TIMEOUT_S=60
WORKER_MEMORY_MB=2048
MAX_ROWS=1000000
MAX_COLUMNS=500
MAX_CELLS=20000000

# --- Display ---
DISPLAY_TIMEZONE=Asia/Karachi

# --- Security ---
# Long random string used to sign cookies and download links. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty, the server generates one and keeps it in STORAGE_DIR/.secret_key (mode 600).
SECRET_KEY=
# Leave empty for same-origin use through the Next.js proxy (recommended).
CORS_ORIGINS=
# Set true when served over HTTPS so the workspace cookie is only sent over TLS.
COOKIE_SECURE=false
# Per-workspace limits on expensive endpoints (upload, export, AI, delete-all).
RATE_LIMITS_ENABLED=true

# --- Optional AI (SPEC D5). The app works fully without these. ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Frontend ---
BACKEND_URL=http://127.0.0.1:8000   # where Next.js forwards /api requests
